  "text_extraction_tests": [
    {
      "test_id": "TC-26",
      "description": "Well-formatted invoice email from the text extraction prompt few-shot example.",
      "input": "From: accounts@globalpack.com\nSubject: Invoice for PO-018\n\nDear Accounts Payable,\n\nPlease find below our invoice for the recent order:\n\nInvoice Number: INV-0018\nDate: April 18, 2026\nSupplier: GlobalPack Solutions (SUP-002)\n\nItem: Nitrile Gloves Medium (NITR-GLV-MED)\nQuantity: 600 units @ $3.50/unit = $2,100.00\n\nNote: Unit pricing applied; PO issued in cases (1 case = 12 units)\n\nPayment terms: Net 30\nPlease remit payment to our standard account.\n\nBest regards,\nGlobalPack Solutions",
      "expected": {
        "extracted_invoices": [
          {
            "invoice_number": "INV-0018",
            "invoice_date": "2026-04-18",
            "supplier_id": "SUP-002",
            "supplier_name": "GlobalPack Solutions",
            "po_reference": "PO-018",
            "item_code": "NITR-GLV-MED",
            "item_description": "Nitrile Gloves Medium",
            "quantity_invoiced": 600,
            "unit_price": 3.50,
            "uom": "units",
            "total_amount": 2100.00,
            "notes": "Unit pricing applied; PO issued in cases (1 case = 12 units)"
          }
        ],
        "extraction_confidence_min": 0.95,
        "fields_not_found": []
      }
    },
    {
      "test_id": "TC-27",
      "description": "Sparse invoice sentence with missing supplier_id and item_code.",
      "input": "Invoice #INV-9999 dated March 15, 2026 from Acme Corp. 100 widgets at $5.00 each. Total: $500.00. Ref: PO-050.",
      "expected": {
        "extracted_invoices": [
          {
            "invoice_number": "INV-9999",
            "invoice_date": "2026-03-15",
            "supplier_id": null,
            "supplier_name": "Acme Corp",
            "po_reference": "PO-050",
            "item_code": null,
            "item_description": null,
            "quantity_invoiced": 100,
            "unit_price": 5.00,
            "uom": null,
            "total_amount": 500.00,
            "notes": null
          }
        ],
        "fields_not_found_includes": ["supplier_id", "item_code"]
      }
    },
    {
      "test_id": "TC-28",
